# AI Video Generation Manager - example environment file.
# Copy to ".env" and fill in only what you actually have.
# NEVER commit the real .env file. Every value below is a placeholder.

# ---------------------------------------------------------------------------
# Core application
# ---------------------------------------------------------------------------
# Where the database, thumbnails, outputs, inbox and logs live.
# D: is preferred on this machine because C: has very little free space.
AVM_DATA_ROOT=D:\AIVideoManager

# Bind address. Keep 127.0.0.1 so the app is not reachable from the network.
AVM_HOST=127.0.0.1
AVM_PORT=8765

# Shared secret for the local UI. Leave blank to disable the check.
# If set, the browser must present it once (stored in a cookie) before the
# API accepts mutating requests.
AVM_UI_TOKEN=

# ---------------------------------------------------------------------------
# Spending controls - paid generation is OFF unless you explicitly enable it.
# ---------------------------------------------------------------------------
AVM_PAID_ENABLED=false
AVM_MONTHLY_SPEND_CAP_USD=0

# ---------------------------------------------------------------------------
# FFmpeg (leave blank to auto-detect on PATH)
# Install with:  winget install Gyan.FFmpeg      or      choco install ffmpeg
# ---------------------------------------------------------------------------
AVM_FFMPEG_PATH=
AVM_FFPROBE_PATH=

# ---------------------------------------------------------------------------
# Script writing (Google AI Studio) - https://aistudio.google.com/apikey
# Leave blank to use the paste-it-yourself flow instead. The free-tier
# requests-per-day allowance is set per project; check it in AI Studio.
# ---------------------------------------------------------------------------
AVM_GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Borrowed GPU time. Both are free; neither is used until filled in.
# This machine has 2 GB of VRAM, which is below the minimum any open-source
# animation or lip-sync model states, so that work runs elsewhere.
# ---------------------------------------------------------------------------

# Kaggle (preferred). Create a token at https://www.kaggle.com/settings
# and copy the two values out of the kaggle.json it downloads.
# The weekly GPU allowance is read live from Kaggle, never assumed here.
AVM_KAGGLE_USERNAME=
AVM_KAGGLE_KEY=
# Optional: a dataset of pinned model weights, as owner/dataset-slug.
# Without it, every run spends part of the allowance re-downloading them.
AVM_KAGGLE_WEIGHTS_DATASET=

# ---------------------------------------------------------------------------
# Free media libraries for real photos and footage.
# Wikimedia Commons needs no key and is always searched first.
# Pixabay is optional: a free key from https://pixabay.com/api/docs/ adds
# stock video. Default limit 100 requests a minute; results are cached 24h.
# ---------------------------------------------------------------------------
AVM_PIXABAY_API_KEY=

# Hugging Face Space (fallback). You choose the Space; this app cannot know
# a Space's argument order, so the endpoint name is configuration.
# A token is only needed for a private Space: https://huggingface.co/settings/tokens
AVM_HF_TOKEN=
AVM_HF_SPACE_I2V=
AVM_HF_SPACE_LIPSYNC=
AVM_HF_SPACE_API_NAME=predict

# ---------------------------------------------------------------------------
# Provider credentials.
# All blank by default. An adapter stays disabled until its key is present,
# and stays marked UNVERIFIED until a real call to the provider succeeds.
# Sign-up URLs are listed in docs/SETUP_CHECKLIST.md.
# ---------------------------------------------------------------------------

# Alibaba Cloud Model Studio (Wan image-to-video) - https://bailian.console.alibabacloud.com/
AVM_ALIBABA_API_KEY=
AVM_ALIBABA_REGION=singapore

# BytePlus ModelArk (Seedance) - https://console.byteplus.com/ark
AVM_BYTEPLUS_API_KEY=

# fal.ai - https://fal.ai/dashboard/keys
AVM_FAL_API_KEY=

# Replicate - https://replicate.com/account/api-tokens
AVM_REPLICATE_API_TOKEN=

# MiniMax / Hailuo - https://platform.minimax.io
AVM_MINIMAX_API_KEY=
AVM_MINIMAX_GROUP_ID=

# PixVerse platform API - https://platform.pixverse.ai
AVM_PIXVERSE_API_KEY=

# Runway - https://dev.runwayml.com
AVM_RUNWAY_API_KEY=

# Luma - https://platform.lumalabs.ai
AVM_LUMA_API_KEY=

# Pika API Club - https://dev.pika.art
AVM_PIKA_API_KEY=

# Vidu - https://platform.vidu.com
AVM_VIDU_API_KEY=

# Kling (Kuaishou) - https://kling.ai/dev
AVM_KLING_ACCESS_KEY=
AVM_KLING_SECRET_KEY=
